<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 同 DebugProfile.entitlements（Keychain Sharing，flutter_secure_storage
	     darwin README 要求）。 -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)dev.zcodeapp.zcodePocket</string>
	</array>
	<!-- 同 DebugProfile.entitlements（早前批次 ：Time Sensitive
	     Notifications，审批提醒 timeSensitive 呈现的配套能力）。 -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
</dict>
</plist>
